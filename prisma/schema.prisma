  status              String               @db.VarChar(20)
  created_by          String
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  logs                ProductDocLog[]
  // PBI-102: pointer naar de huidige (laatste) immutable revision; bij
  // elke create/update via lib/product-doc-write.ts wordt deze geüpdatet.
  // Nullable tijdens dual-write/migratie; wordt non-null na backfill.
  current_revision_id String?              @unique
  current_revision    ProductDocRevision?  @relation("CurrentRevision", fields: [current_revision_id], references: [id], onDelete: SetNull)
  revisions           ProductDocRevision[] @relation("DocRevisions")
  sections            ProductDocSection[]  @relation("ProductDocSections")
  source_links        ProductDocLink[]     @relation("ProductDocSourceLinks")
  target_links        ProductDocLink[]     @relation("ProductDocTargetLinks")
  // PBI-102: één-op-één back-relations vanuit Idea (zelfde Idea kan
  // alleen één PLAN- en één GRILL-doc hebben — zie Idea.plan_doc_id /
  // grill_doc_id met @unique).
  idea_plan            Idea?                @relation("IdeaPlanDoc")
  idea_grill           Idea?                @relation("IdeaGrillDoc")
  review_logs          ReviewLog[]          @relation("DocReviewLogs")
  review_jobs          ClaudeJob[]          @relation("JobReviewDoc")

  @@unique([product_id, folder, slug])
  @@index([product_id, folder, updated_at])
  @@index([product_id, status])
  @@map("product_docs")
}

// PBI-102: immutable snapshot van ProductDoc-content per save. PbiDoc
// wijst naar een specifieke revision (niet naar de mutable ProductDoc),
// zodat de bron van een PBI nooit stilzwijgend mee-verschuift bij latere
// doc-edits. Append-only; `revision` is monotoon stijgend per doc.
model ProductDocRevision {
  id           String      @id @default(cuid())
  doc          ProductDoc  @relation("DocRevisions", fields: [doc_id], references: [id], onDelete: Cascade)
  doc_id       String
  revision     Int
  title        String      @db.VarChar(200)
  status       String      @db.VarChar(20)
  content_md   String      @db.Text
  content_hash String      @db.VarChar(64)
  created_by   String
  created_at   DateTime    @default(now())
  pbi_links    PbiDoc[]
  current_for  ProductDoc? @relation("CurrentRevision")
  sections     ProductDocSection[] @relation("ProductDocRevisionSections")
  review_logs  ReviewLog[] @relation("DocRevisionReviewLogs")

  @@unique([doc_id, revision])
  @@index([doc_id, created_at])
  @@map("product_doc_revisions")
}

// PBI-102: junction tussen Pbi en ProductDocRevision met rol (PLAN/GRILL).
// `onDelete: Restrict` op de revisie zodat een PBI-link niet stilzwijgend
// kan verdwijnen — wel mag de hele doc (ProductDoc) gecascadet worden,
// dat verwijdert de revisies en daarmee ook deze PbiDoc-rijen.
model PbiDoc {
  id              String             @id @default(cuid())
  pbi             Pbi                @relation(fields: [pbi_id], references: [id], onDelete: Cascade)
  pbi_id          String
  doc_revision    ProductDocRevision @relation(fields: [doc_revision_id], references: [id], onDelete: Restrict)
  doc_revision_id String
  role            PbiDocRole
  created_at      DateTime           @default(now())
  created_by      String

  @@unique([pbi_id, doc_revision_id, role])
  @@index([pbi_id])
  @@index([doc_revision_id])
  @@map("pbi_docs")
}

// Current-revision derived sections for ProductDocs. Rebuildable; canonical
// history remains ProductDocRevision.content_md.
model ProductDocSection {
  id            String             @id @default(cuid())
  product       Product            @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id    String
  doc           ProductDoc         @relation("ProductDocSections", fields: [doc_id], references: [id], onDelete: Cascade)
  doc_id        String
  revision      ProductDocRevision @relation("ProductDocRevisionSections", fields: [revision_id], references: [id], onDelete: Cascade)
  revision_id   String
  folder        ProductDocFolder
  slug          String             @db.VarChar(80)
  anchor        String             @db.VarChar(120)
  heading_path  String             @db.VarChar(500)
  heading_level Int
  sort_order    Int
  title         String             @db.VarChar(200)
  status        String             @db.VarChar(20)
  content_text  String             @db.Text
  content_hash  String             @db.VarChar(64)
  updated_at    DateTime           @updatedAt
  source_links  ProductDocLink[]   @relation("ProductDocSectionSourceLinks")
  target_links  ProductDocLink[]   @relation("ProductDocSectionTargetLinks")

  @@unique([doc_id, anchor])
  @@index([product_id, folder, slug])
  @@index([revision_id])
  @@index([doc_id])
  @@map("product_doc_sections")
}

// Derived link graph for ProductDocs. Stores raw + normalized targets so
// broken/ambiguous rows can be re-resolved when docs are created or renamed.
model ProductDocLink {
  id                String             @id @default(cuid())
  product           Product            @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id        String
  source_doc        ProductDoc         @relation("ProductDocSourceLinks", fields: [source_doc_id], references: [id], onDelete: Cascade)
  source_doc_id     String
  source_section    ProductDocSection? @relation("ProductDocSectionSourceLinks", fields: [source_section_id], references: [id], onDelete: Cascade)
  source_section_id String?
  target_doc        ProductDoc?        @relation("ProductDocTargetLinks", fields: [target_doc_id], references: [id], onDelete: SetNull)
  target_doc_id     String?
  target_section    ProductDocSection? @relation("ProductDocSectionTargetLinks", fields: [target_section_id], references: [id], onDelete: SetNull)
  target_section_id String?
  raw_href          String             @db.Text
  normalized_href   String?            @db.Text
  target_folder     ProductDocFolder?
  target_slug       String?            @db.VarChar(80)
  target_anchor     String?            @db.VarChar(120)
  link_type         String             @db.VarChar(20)
  anchor            String?            @db.VarChar(120)
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  @@index([product_id, source_doc_id])
  @@index([target_doc_id])
  @@index([target_folder, target_slug, target_anchor])
  @@map("product_doc_links")
}

model ProductDocIndexConfig {
  id            String   @id @default(cuid())
  product       Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id    String   @unique
  curator_md    String   @db.Text
  generated_md  String?  @db.Text
  generated_at  DateTime?
  index_version Int      @default(1)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("product_doc_index_configs")
}

model ProductDocLog {
  id            String            @id @default(cuid())
  product       Product           @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id    String
  doc           ProductDoc?       @relation(fields: [doc_id], references: [id], onDelete: SetNull)
  doc_id        String?
  actor_user_id String
  type          ProductDocLogType
  metadata      Json?
  created_at    DateTime          @default(now())

  @@index([product_id, created_at])
  @@index([doc_id, created_at])
  @@index([actor_user_id, created_at])
  @@map("product_doc_logs")
}

model Idea {
  id              String      @id @default(cuid())
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id         String
  product         Product?    @relation(fields: [product_id], references: [id], onDelete: SetNull)
  product_id      String?
  code            String      @db.VarChar(30)
  title           String
  description     String?     @db.VarChar(4000)
  grill_md        String?     @db.Text
  plan_md         String?     @db.Text
  plan_review_log Json? // ReviewLog from orchestrator (all rounds, convergence metrics, approval status)
  reviewed_at     DateTime? // When last reviewed
  pbi             Pbi?        @relation(fields: [pbi_id], references: [id], onDelete: SetNull)
  pbi_id          String?     @unique
  // PBI-102: actuele PLAN/GRILL-ProductDoc (huidige versie). PbiDoc
  // bevriest de specifieke revisie ten tijde van PBI-creatie; deze
  // pointer kan daarna nog verschuiven als plan_md/grill_md opnieuw
  // gesaved wordt. `grill_md` en `plan_md` blijven tijdens dual-write
  // bestaan voor backward-compat (drop in vervolg-PBI).
  plan_doc        ProductDoc? @relation("IdeaPlanDoc", fields: [plan_doc_id], references: [id], onDelete: SetNull)
  plan_doc_id     String?     @unique
  grill_doc       ProductDoc? @relation("IdeaGrillDoc", fields: [grill_doc_id], references: [id], onDelete: SetNull)
  grill_doc_id    String?     @unique
  status          IdeaStatus  @default(DRAFT)
  archived        Boolean     @default(false)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  questions          ClaudeQuestion[]
  jobs               ClaudeJob[]
  logs               IdeaLog[]
  chat_messages      IdeaChatMessage[]
  user_questions     UserQuestion[]
  secondary_products IdeaProduct[]
  notifications      IdeaNotification[]
  review_logs        ReviewLog[]         @relation("IdeaReviewLogs")

  @@unique([user_id, code])
  @@index([user_id, archived, status])
  @@index([user_id, product_id])
  @@map("ideas")
}

model IdeaProduct {
  id         String   @id @default(cuid())
  idea_id    String
  product_id String
  created_at DateTime @default(now())

  idea    Idea    @relation(fields: [idea_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([idea_id, product_id])
  @@index([product_id])
  @@map("idea_products")
}

model IdeaLog {
  id         String      @id @default(cuid())
  idea       Idea        @relation(fields: [idea_id], references: [id], onDelete: Cascade)
  idea_id    String
  type       IdeaLogType
  content    String      @db.Text
  metadata   Json?
  created_at DateTime    @default(now())

  @@index([idea_id, created_at])
  @@map("idea_logs")
}

// M17 idea-chat: chat-channel per idee. Conversationele inhoud; audit blijft
// IdeaLog (projectie in de kanaal-view), open vragen blijven ClaudeQuestion
// (spec 2026-07-03 idea-chat-channel §3).
model IdeaChatMessage {
  id         String              @id @default(cuid())
  idea       Idea                @relation(fields: [idea_id], references: [id], onDelete: Cascade)
  idea_id    String
  role       IdeaChatRole
  kind       IdeaChatMessageKind @default(TEXT)
  content    String              @db.Text
  metadata   Json?
  job        ClaudeJob?          @relation(fields: [job_id], references: [id], onDelete: SetNull)
  job_id     String?
  created_at DateTime            @default(now())

  @@index([idea_id, created_at])
  @@map("idea_chat_messages")
}

model UserQuestion {
  id         String             @id @default(cuid())
  idea_id    String
  user_id    String
  question   String             @db.Text
  answer     String?            @db.Text
  status     UserQuestionStatus @default(pending)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  idea Idea @relation(fields: [idea_id], references: [id], onDelete: Cascade)

  @@index([idea_id, status])
  @@index([user_id])
  @@map("user_questions")
}

model LoginPairing {
  id                 String    @id @default(cuid())
  secret_hash        String
  desktop_token_hash String
  status             String
  user_id            String?
  user               User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  desktop_ua         String?   @db.VarChar(255)
  desktop_ip         String?   @db.VarChar(45)
  created_at         DateTime  @default(now())
  expires_at         DateTime
  approved_at        DateTime?
  consumed_at        DateTime?

  @@index([expires_at])
  @@index([status, expires_at])
  @@map("login_pairings")
}

model ClaudeQuestion {
  id          String    @id @default(cuid())
  story       Story?    @relation(fields: [story_id], references: [id], onDelete: Cascade)
  story_id    String?
  task        Task?     @relation(fields: [task_id], references: [id], onDelete: SetNull)
  task_id     String?
  idea        Idea?     @relation(fields: [idea_id], references: [id], onDelete: Cascade)
  idea_id     String?
  product     Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id  String // gedenormaliseerd uit story.product_id voor SSE-filter
  asker       User      @relation("ClaudeQuestionAsker", fields: [asked_by], references: [id])
  asked_by    String // user_id van token-houder (= Claude-token)
  question    String    @db.Text
  options     Json? // string[] voor multi-choice; null voor free-text
  status      String // 'open' | 'answered' | 'cancelled' | 'expired'
  answer      String?   @db.Text
  answerer    User?     @relation("ClaudeQuestionAnswerer", fields: [answered_by], references: [id])
  answered_by String?
  answered_at DateTime?
  created_at  DateTime  @default(now())
  expires_at  DateTime // ingesteld door MCP-tool, default now() + 24h

  @@index([story_id, status])
  @@index([idea_id, status])
  @@index([product_id, status])
  @@index([status, expires_at])
  @@map("claude_questions")
}

model PushSubscription {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id      String
  endpoint     String   @unique
  p256dh       String
  auth         String
  user_agent   String?
  created_at   DateTime @default(now())
  last_used_at DateTime @default(now())

  @@index([user_id])
  @@map("push_subscriptions")
}

model IdeaNotification {
  id         String        @id @default(cuid())
  idea_id    String
  user_id    String
  product_id String
  job_id     String        @unique
  kind       ClaudeJobKind
  read_at    DateTime?
  created_at DateTime      @default(now())

  idea Idea      @relation(fields: [idea_id], references: [id], onDelete: Cascade)
  user User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  job  ClaudeJob @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@index([user_id, read_at])
  @@map("idea_notifications")
}

// IDEA-118 K7: copilot-chat-historie, centraal per product. Bewust géén
// user-FK (single-user-ecosysteem); audit via app_key_label (spec §6.4).
model CopilotChatSession {
  id            String               @id @default(cuid())
  product       Product              @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id    String
  title         String?
  app_key_label String
  app_user_ref String?
  user_id      String?
  archived      Boolean              @default(false)
  created_at    DateTime             @default(now())
  updated_at    DateTime             @updatedAt
  messages      CopilotChatMessage[]

  @@index([product_id, updated_at])
  @@map("copilot_chat_sessions")
}

model CopilotChatMessage {
  id         String             @id @default(cuid())
  session    CopilotChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  session_id String
  role       String
  content    Json
  aborted    Boolean            @default(false)
  created_at DateTime           @default(now())

  @@index([session_id, created_at])
  @@map("copilot_chat_messages")
}

// IDEA-118 vervolg: koppelt een host-app-user (app_user_ref, door de host
// doorgegeven en via de app-key vertrouwd) aan een scrum4me User. Admin-managed.
// De service berekent de EFFECTIEVE toegang per product uit owner-of-member
// (zie resolveMember) — de mapping legt enkel "deze app-user = deze User" vast.
model CopilotAppUser {
  id            String               @id @default(cuid())
  product       Product              @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id    String
  app_key_label String
  app_user_ref  String
  user          User?                @relation(fields: [user_id], references: [id], onDelete: SetNull)
  user_id       String?
  status        CopilotAppUserStatus @default(PENDING)
  first_seen_at DateTime             @default(now())
  linked_at     DateTime?
  linked_by     String?
  @@unique([product_id, app_key_label, app_user_ref])
  @@index([product_id, status])
  @@map("copilot_app_users")
}

/// Per-kind runtime-config, live (DB-leading) geresolved op claim-time
/// (scrum4me-mcp getFullJobContext), niet via een enqueue-snapshot.
/// Migratie draait in scrum4me-web (designated migrator), niet hier.
model JobKindConfig {
  kind                   ClaudeJobKind @id
  claude_model           String?
  codex_model            String?
  thinking_budget        Int?
  claude_permission_mode String?
  codex_sandbox_mode     String?
  allow_all_tools        Boolean       @default(false)
  allowed_tools          String[]
  skills                 String[]
  max_turns              Int?
  updated_at             DateTime      @updatedAt

  @@map("job_kind_config")
}
