/// s4m-queue berichten-queue (fase 1 — scrum4me-mcp spec
/// 2026-07-12-s4m-queue-mcp-integration-design.md §4). Tabel-DDL identiek aan
/// s4m-queue/migrations/001_init.sql, met twee afwijkingen: de source-CHECK
/// krijgt er 'mcp' bij (§4 punt 2 — staat in de SQL-migratie, niet hier) en er
/// komt een index op in_reply_to (§4 punt 3 — nodig voor de reply-claim-filter
/// van fase 2).
///
/// De s4m-queue-CLI (raw SQL) en het Messages-dashboard blijven op deze tabel
/// werken en wisselen straks alléén van connection string — tabel- en
/// kolomnamen zijn daarom byte-identiek aan de bron.
///
/// Bewuste afwijkingen van de huisstijl van dit schema (cuid + DateTime):
/// - @db.Uuid + @db.Timestamptz(6) houden de kolomtypes gelijk aan 001_init.sql;
///   id krijgt daarom dbgenerated("gen_random_uuid()") i.p.v. @default(cuid()).
/// - replied_to/replies bestaan uitsluitend om de FK te emitten: Prisma kent
///   geen FK zonder relatieveld en vereist daarbij de back-relation. Niets
///   consumeert ze — CLI en dashboard zijn raw SQL. Ze zien er daardoor
///   ongebruikt uit, maar het paar weghalen laat prisma validate groen terwijl
///   de FK stilzwijgend uit de DDL verdwijnt (alleen `replies` weghalen geeft
///   wél P1012). Alleen __tests__/agent-message-schema.test.ts vangt dat: die
///   maakt npm run verify dan rood.
/// - onUpdate: NoAction op de self-relation, omdat de bron-FK geen
///   ON UPDATE-clausule heeft (Prisma's default is Cascade).
/// - map: op @@index pint de indexnamen van 001_init.sql vast; zonder map:
///   maakt Prisma er agent_message_to_server_to_model_status_created_at_idx
///   van en breekt de belofte "DDL identiek aan 001_init.sql". Op de
///   in_reply_to-index is map: toevallig gelijk aan Prisma's default; die
///   blijft staan voor symmetrie en zodat de naam niet meedrift bij een
///   kolomhernoeming.
/// - CHECK-constraints (type, source, status, reply_link_matches_type) staan
///   hier bewust niet: Prisma kent ze niet. Ze staan in de SQL-migratie.
///
/// Migratie draait in Scrum4Me (designated migrator), niet hier.
model AgentMessage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String
  from_server String
  from_model  String
  to_server   String
  to_model    String
  body        String
  meta        Json      @default("{}")
  source      String
  status      String    @default("pending")
  in_reply_to String?   @db.Uuid
  error       String?
  claimed_by  String?
  claimed_at  DateTime? @db.Timestamptz(6)
  started_at  DateTime? @db.Timestamptz(6)
  finished_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  // M30 P0.3: push-idempotentie. De partiele unieke index en de watcher-index
  // zijn SQL-only (PSL kent geen partiele indexen) en leven in de
  // Scrum4Me-migratie + s4m-queue/migrations/001_init.sql.
  idempotency_key String?
  /// M32 inbox-archivering: moment van archiveren; NULL = actief. Alleen
  /// terminale rijen (done/failed/cancelled) mogen een waarde krijgen —
  /// afgedwongen in code (CLI/MCP/hub/workers), bewust niet met een CHECK.
  archived_at DateTime? @db.Timestamptz(6)

  replied_to AgentMessage?  @relation("AgentMessageReplies", fields: [in_reply_to], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replies    AgentMessage[] @relation("AgentMessageReplies")

  @@index([to_server, to_model, status, created_at], map: "agent_message_claim_idx")
  @@index([in_reply_to], map: "agent_message_in_reply_to_idx")
  @@map("agent_message")
}

/// Archief voor s4m-queue-retention: kolommen identiek aan agent_message,
/// bewust zonder FK en zonder CHECK-constraints
/// (zie s4m-queue/migrations/002_archive.sql). Sinds M32 wél één index —
/// (created_at DESC, id DESC) — voor het read-only cold-store-leespad
/// (s4m-queue `list --cold-store`); verder blijft de tabel indexarm.
///
/// Let op voor de SQL-migratie: dit archief krijgt in het geheel géén
/// CHECK-constraints — dus óók niet op type, source en status, anders dan
/// agent_message. De header van 002_archive.sql noemt bij de weglatingen
/// alleen reply_link_matches_type, maar de DDL laat alle vier de CHECKs
/// van 001_init.sql weg; die opsomming is onvolledig, niet de tabel.
///
/// id en created_at hebben hier géén default: archiefrijen nemen de waarden
/// van de oorspronkelijke agent_message-rij over. status heeft om dezelfde
/// reden geen default 'pending'.
model AgentMessageArchive {
  id          String    @id @db.Uuid
  type        String
  from_server String
  from_model  String
  to_server   String
  to_model    String
  body        String
  meta        Json      @default("{}")
  source      String
  status      String
  in_reply_to String?   @db.Uuid
  error       String?
  claimed_by  String?
  claimed_at  DateTime? @db.Timestamptz(6)
  started_at  DateTime? @db.Timestamptz(6)
  finished_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @db.Timestamptz(6)
  // M30 P0.3: kolom-identiek aan agent_message (pariteitscontract).
  idempotency_key String?
  archived_at DateTime? @db.Timestamptz(6)

  @@index([created_at(sort: Desc), id(sort: Desc)], map: "agent_message_archive_created_idx")
  @@map("agent_message_archive")
}

// M31 — Communicatiecentrum slice B (IDEA-179). Spec:
// Scrum4Me docs/specs/2026-08-11-communicatie-centrum-slice-b-design.md §6.

enum HubApprovalSource {
  QUESTION
  QUEUE_INFO
  PERMISSION
  CUSTOM
}

enum HubApprovalStatus {
  PENDING
  ANSWERED
  EXPIRED
  CANCELLED
}

enum HubNotificationOutcome {
  DELIVERED // daadwerkelijk afgeleverd — enige outcome die sent_at draagt
  NO_CHANNEL // geen actief device én geen web-push-sub; geen retrylus
  EXHAUSTED // max-attempts bereikt; last_error gevuld
  SUPERSEDED // nieuwer event (hogere state_version) nam de bezorging over
}

enum HubDeviceEnvironment {
  SANDBOX
  PRODUCTION
}

enum HubNotificationKind {
  INITIAL
  ANSWERED
  EXPIRED
  CANCELLED
}

enum HubAnsweredVia {
  APP
  SOURCE
}

model HubDevice {
  id           String        @id @default(cuid())
  user_id      String
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name         String
  public_key   String // P-256 SPKI (DER), base64
  apns_token   String?
  environment  HubDeviceEnvironment
  active       Boolean       @default(true)
  created_at   DateTime      @default(now())
  last_seen_at DateTime?
  approvals    HubApproval[]

  @@map("hub_devices")
}

model HubApproval {
  id                   String                    @id @default(cuid())
  user_id              String
  user                 User                      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  source               HubApprovalSource
  source_ref           String // question-id | queue message-id | permission-uuid
  title                String // kort en letterlijk, ≤80 tekens
  body                 String // detail, ≤1000 tekens
  context_json         Json?
  options              Json? // string[]; null = free-text (alleen Open-actie)
  status               HubApprovalStatus         @default(PENDING)
  answer               String?
  answer_note          String?
  answered_via         HubAnsweredVia?
  device_id            String?
  device               HubDevice?                @relation(fields: [device_id], references: [id])
  expires_at           DateTime
  answered_at          DateTime?
  notification_version Int                       @default(1)
  notifications        HubApprovalNotification[]
  created_at           DateTime                  @default(now())

  @@unique([source, source_ref])
  @@index([status, expires_at])
  @@index([user_id, status])
  @@map("hub_approvals")
}

model HubApprovalNotification {
  id              String                  @id @default(cuid())
  approval_id     String
  approval        HubApproval             @relation(fields: [approval_id], references: [id], onDelete: Cascade)
  state_version   Int // = HubApproval.notification_version bij aanmaak
  kind            HubNotificationKind
  claimed_at      DateTime?
  sent_at         DateTime? // uitsluitend bij outcome DELIVERED
  attempts        Int                     @default(0)
  next_attempt_at DateTime?
  outcome         HubNotificationOutcome?
  completed_at    DateTime?
  last_error      String? // gesaniteerd + getrunceerd, max 500 tekens
  created_at      DateTime                @default(now())

  @@unique([approval_id, state_version])
  @@index([completed_at, next_attempt_at])
  @@map("hub_approval_notifications")
}

model HubPairing {
  id         String    @id @default(cuid())
  token_hash String    @unique // sha256 van het QR-token (lib/auth/pairing.ts-conventie)
  created_by String // user-id van de admin die de QR toonde
  expires_at DateTime // aanmaak + 5 min
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@map("hub_pairings")
}

enum HubPermissionRuleScope {
  GLOBAL
  PRODUCT
}

enum HubPermissionRuleList {
  ALLOW
  DENY
  ASK
}

enum HubPermissionRuleOrigin {
  IMPORT
  APPROVE_ALWAYS
  SYNC_UPLOAD
  MANUAL
}

enum HubPermissionRuleStatus {
  PENDING_CONFIRM
  ACTIVE
  DISABLED
}

model HubPermissionRule {
  id          String                  @id @default(cuid())
  scope       HubPermissionRuleScope
  repo_key    String?
  rule        String
  list        HubPermissionRuleList   @default(ALLOW)
  origin      HubPermissionRuleOrigin
  origin_host String?
  status      HubPermissionRuleStatus @default(ACTIVE)
  note        String?
  created_at  DateTime                @default(now())
  updated_at  DateTime                @updatedAt

  // repo_key is nullable (NULL = GLOBAL scope). Postgres treats NULLs as distinct in a
  // plain UNIQUE, so this composite @@unique only dedups PRODUCT rows (repo_key NOT NULL).
  // GLOBAL rows (repo_key IS NULL) are deduped by a partial unique index
  // `(scope, rule, list) WHERE repo_key IS NULL`, created together with a CHECK
  // ((scope = 'GLOBAL') = (repo_key IS NULL)) in each consumer's migration. Prisma's schema
  // DSL can express neither a partial unique index nor a CHECK, so both live in migration
  // SQL — a consumer that adopts this model MUST add them (see the consumer HubPermissionRule
  // migration; Scrum4Me: 20260815090000_hub_permission_rules).
  @@unique([scope, repo_key, rule, list])
  @@map("hub_permission_rules")
}

model Issue {
  id                   String           @id @default(cuid())
  product              Product          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id           String
  user                 User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id              String
  code                 String           @db.VarChar(30)
  title                String           @db.VarChar(200)
  description          String           @db.Text
  research_md          String?          @db.Text
  resolution_md        String?          @db.Text
  status               IssueStatus      @default(NEW)
  resolution           IssueResolution?
  closed_at            DateTime?
  severity             IssueSeverity    @default(S3_MAJOR)
  reported_by          String?          @db.VarChar(60)
  fingerprint          String?          @db.VarChar(200)
  occurrence_count     Int              @default(1)
  last_seen_at         DateTime         @default(now())
  linked_pbi           Pbi?             @relation("IssueLinkedPbi", fields: [linked_pbi_id], references: [id], onDelete: SetNull)
  linked_pbi_id        String?
  linked_idea          Idea?            @relation("IssueLinkedIdea", fields: [linked_idea_id], references: [id], onDelete: SetNull)
  linked_idea_id       String?
  forgejo_repo         String?          @db.VarChar(200)
  forgejo_number       Int?
  forgejo_synced_at    DateTime?
  forgejo_attempted_at DateTime?
  forgejo_dirty        Boolean          @default(true)
  forgejo_sync_seq     Int              @default(0)
  forgejo_error        String?          @db.VarChar(500)
  archived             Boolean          @default(false)
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt
  logs                 IssueLog[]

  @@unique([product_id, code])
  @@index([product_id, status])
  @@index([product_id, fingerprint])
  @@map("issues")
}

model IssueLog {
  id         String       @id @default(cuid())
  issue      Issue        @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  issue_id   String
  type       IssueLogType
  content    String       @db.Text
  metadata   Json?
  created_at DateTime     @default(now())

  @@index([issue_id, created_at])
  @@map("issue_logs")
}
