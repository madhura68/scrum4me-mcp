  spec_doc            ProductDoc? @relation("IdeaSpecDoc", fields: [spec_doc_id], references: [id], onDelete: SetNull)
  spec_doc_id         String?     @unique
  build_sprint        Sprint?     @relation("IdeaBuildSprint", fields: [build_sprint_id], references: [id], onDelete: SetNull)
  build_sprint_id     String?
  build_sprint_run    SprintRun?  @relation("IdeaBuildSprintRun", fields: [build_sprint_run_id], references: [id], onDelete: SetNull)
