# PostgreSQL connection string for the Scrum4Me database
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# API token from Scrum4Me → /settings/tokens
SCRUM4ME_TOKEN=""

# Internal push endpoint (main-app) for web-push notifications
# Set to the main-app /api/internal/push/send URL; leave empty to disable push (feature-gated).
INTERNAL_PUSH_URL="https://scrum4me.example.com/api/internal/push/send"
# Shared secret (≥32 chars) — must match INTERNAL_PUSH_SECRET in the main-app env.
INTERNAL_PUSH_SECRET="<generate-with: openssl rand -hex 32>"

# ---------------------------------------------------------------------------
# Queue dispatch service (IDEA-213) — see README › Queue dispatch service.
# Only the service itself reads the block below; it ships off and every value
# here is a shape, never a real one. Secret ownership is in the README table.
# ---------------------------------------------------------------------------

# Dispatch database as the limited contract role scrum4me_dispatch (required).
DISPATCH_DATABASE_URL=""
# Queue database as s4m_dispatch_projector. Empty: no delivery, repair or retention.
DISPATCH_QUEUE_DATABASE_URL=""

# Intake and selection. Set to 1 last in a rollout; anything else keeps the
# service read/cancel/recover only.
DISPATCH_ENABLED=""
# Comma-separated product ids that may dispatch. Empty means none.
DISPATCH_PRODUCT_ALLOWLIST=""

# Listener and timers (defaults shown). The tick interval is the safety net under
# the dispatch_tick NOTIFY, which needs no configuration and no grant: it runs on
# DISPATCH_DATABASE_URL and only pulls the next tick forward.
DISPATCH_HOST="127.0.0.1"
DISPATCH_PORT="4319"
DISPATCH_TICK_INTERVAL_MS="5000"
DISPATCH_MAINTENANCE_INTERVAL_MS="900000"
# Whole days before a terminal, acknowledged thread is archived. Empty: no retention.
DISPATCH_RETENTION_DAYS=""

# Shared with scrum4me-workers and the Scrum4Me web app respectively; >=32 bytes
# UTF-8 and byte-identical on both sides. Generate with: openssl rand -hex 32
DISPATCH_WORKERS_ASSERTION_KEY=""
DISPATCH_WEB_ASSERTION_KEY=""

# Attempt/session credential keys, "<version>:<base64url>" and comma separated,
# each >=32 bytes. Keep old versions until every attempt issued under them is
# retired — removing one invalidates live credentials silently.
DISPATCH_CREDENTIAL_KEYS="1:<base64url-32-bytes-or-more>"
DISPATCH_CREDENTIAL_KEY_VERSION="1"
# Ed25519 private key, PKCS8 PEM. Without it and the keys above there are no
# executor/attempt routes at all.
DISPATCH_START_PERMIT_PRIVATE_KEY=""
# The key id carried by every issued permit. It is part of the executor
# condition next to the private key and the credential keys: a private key
# without a kid is an unconfigured signer, so the executor/attempt routes stay
# absent. Bounded ASCII, no `:` or `,`.
DISPATCH_START_PERMIT_KEY_ID=""
# Prepared-source-manifest signer. Its OWN Ed25519 key + kid, distinct from the
# permit above; there is no fallback to the permit key. Both must be present or
# the manifest route stays unavailable.
DISPATCH_SOURCE_MANIFEST_PRIVATE_KEY=""
DISPATCH_SOURCE_MANIFEST_KEY_ID=""

# Child-output capability. Opt-in base64url HMAC key, >=32 bytes decoded.
# Present: the `/agent/*` gateway exists and mints the bounded attempt-scoped
# capability the child holds. Absent (or too short): those routes never exist
# and no capability is ever minted. Not a bearer; grants no MCP tool, database
# or forge access.
DISPATCH_AGENT_OUTPUT_KEY=""

# Publication. The single allowed forge host, its token (central publisher
# credential — never handed to a supervisor, image or model), the writable
# working root and the one default base branch.
DISPATCH_GIT_HOST=""
DISPATCH_GIT_TOKEN=""
DISPATCH_PUBLICATION_ROOT=""
DISPATCH_BASE_BRANCH="main"

# Repository source preparation: the writable root a pinned base is checked out
# in (0700, one directory per request, removed again afterwards) and the schemes
# it may fetch over. Empty root: intake refuses every request that pins a
# repository. Leave the protocols at https; file is for an isolated local
# fixture repository on a disposable cluster only.
DISPATCH_WORKSPACE_ROOT=""
DISPATCH_GIT_PROTOCOLS="https"

# Clients (MCP dispatch tools, s4m-queue CLI, workers, web): the service URL.
# The caller's own bearer is SCRUM4ME_TOKEN above; there is no service identity.
S4M_DISPATCH_URL=""
