{
  "name": "scrum4me-mcp",
  "version": "1.1.0",
  "description": "MCP server for Scrum4Me — exposes dev-flow tools and prompts via the Model Context Protocol",
  "type": "module",
  "//files": "Repo-only package: run from a `git clone --recurse-submodules` (tsx over src/ + vendored @shared), never from an npm registry/tarball. src/, vendor/, scripts/ and tsconfig.json — needed by the tsx runtime scripts — are intentionally NOT listed here, so `npm pack` is deliberately minimal and unsupported. See README › Setup.",
  "files": [
    "prisma",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "build": "tsc --noEmit",
    "start": "node_modules/.bin/tsx src/index.ts",
    "start:http": "node_modules/.bin/tsx src/http.ts",
    "prisma:generate": "bash scripts/gen-schema.sh > prisma/schema.prisma && prisma generate",
    "postinstall": "bash scripts/gen-schema.sh > prisma/schema.prisma && prisma generate || true",
    "prebuild": "bash scripts/gen-schema.sh > prisma/schema.prisma && prisma generate",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.type-tests.json",
    "pretest": "npm run typecheck:tests",
    "usage:canary": "tsx scripts/check-worker-usage-capture.ts",
    "sync-schema": "bash scripts/sync-schema.sh",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "scrum4me",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/proper-lockfile": "^4.1.4",
    "express": "^4.22.2",
    "pg": "^8.13.1",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.8.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "prisma": "^7.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
